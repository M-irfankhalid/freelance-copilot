# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored on purpose.

# Backend API port (named SERVER_PORT so generic PORT env vars from
# hosting tools cannot collide with the frontend)
SERVER_PORT=4000

# SQLite database file (created automatically; "data/" is git-ignored)
DATABASE_PATH=./data/app.db

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Frontend origin allowed to call the API (comma separated for extras)
CLIENT_ORIGIN=http://localhost:5173

# Master secret used to encrypt platform credentials at rest (AES-256-GCM).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you lose it, saved credentials become unreadable and must be re-entered.
ENCRYPTION_KEY=

# Freelancer.com personal access token — BYOC, entered in the app (Phase 5).
# Present here only as a development fallback; never commit real values.
FREELANCER_ACCESS_TOKEN=

# OpenRouter API key — BYOC, entered in the app (Phase 5).
OPENROUTER_API_KEY=
