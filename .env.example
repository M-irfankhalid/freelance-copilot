# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored on purpose.

# Production only. Leave unset for local development; the Docker setup sets
# it automatically. In production, session cookies are marked Secure, so the
# app must be opened over HTTPS (or http://localhost).
# NODE_ENV=production

# Backend API port (named SERVER_PORT so generic PORT env vars from
# hosting tools cannot collide with the frontend)
SERVER_PORT=4000

# SQLite database file (created automatically; "data/" is git-ignored)
DATABASE_PATH=./data/app.db

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Keep true for the API server. The MCP stdio entry point forces this off
# internally so logs cannot corrupt the JSON-RPC stream.
LOG_STDOUT=true

# Allow MCP clients (ChatGPT via Secure MCP Tunnel, local MCP clients) to
# update the profile and edit draft proposals. Set false for read-only access.
MCP_ALLOW_WRITES=true

# Frontend origin allowed to call the API (comma separated for extras).
# Local development uses the Vite port. In Docker the web app and API share
# an origin, so http://localhost:4000 is the right value (the compose file
# already sets this).
CLIENT_ORIGIN=http://localhost:5173

# Session cookies are Secure in production, which requires HTTPS (localhost
# is exempt). Set false only for a trusted LAN install over plain HTTP.
# COOKIE_SECURE=false

# Master secret used to encrypt platform credentials at rest (AES-256-GCM).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you lose it, saved credentials become unreadable and must be re-entered.
ENCRYPTION_KEY=

# Freelancer.com personal access token — BYOC, normally entered in the app.
# Present here only as a development fallback; never commit real values.
FREELANCER_ACCESS_TOKEN=

# OpenRouter API key — BYOC, normally entered in the app.
OPENROUTER_API_KEY=
