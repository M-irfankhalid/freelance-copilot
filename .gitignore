# Dependencies
node_modules

# Environment and secrets — never commit
.env
.env.*
!.env.example

# Build output
dist
dist-ssr
build

# Database files (self hosted SQLite lives here)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Anchored to repo root. A bare `data/` also matches apps/web/src/lib/data/,
# which silently excluded 7 real source files from version control.
/data/

# Tooling scratch (understand-anything output)
.ua/

# Logs
# Anchored to repo root. A bare `logs` also matches apps/web/src/pages/logs/,
# which silently excluded that route from version control.
/logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Claude settings (user-local, never commit)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?
